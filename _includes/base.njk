<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} – Paz Javiera</title>
  <link rel="stylesheet" href="{{ '/style.css' | url }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/GLightbox/3.2.0/css/glightbox.min.css">
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

  <header class="header">
    <a href="{{ '/index.html' | url }}" class="logo-container">
      <span class="logo">Paz Javiera</span>
      {% if page.url == '/' or page.url == '/index.html' %}
      <span class="logo-subtitle">Obra</span>
      {% endif %}
    </a>
    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false">
      <span class="hamburger"></span>
    </button>
    <nav class="nav-menu">
      <button class="nav-close" aria-label="Cerrar menú">✕</button>
      <a href="{{ '/index.html' | url }}">Obra</a>
      <a href="{{ '/biografia.html' | url }}">Biografía</a>
      <a href="{{ '/exposiciones.html' | url }}">Exposiciones</a>
      <a href="{{ '/proyectos.html' | url }}">Proyectos</a>
      <a href="{{ '/contacto.html' | url }}">Contacto</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/GLightbox/3.2.0/js/glightbox.min.js"></script>
  <script src="{{ '/script.js' | url }}"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "{{ '/admin/' | url }}";
          });
        }
      });
    }
  </script>
</body>
</html>
